<div
    id="contactModal"
    class="hidden fixed flex justify-center items-center z-50 inset-0 bg-zinc-600 bg-opacity-50 overflow-y-auto h-full w-full transition-opacity duration-300 ease-in-out"
    >
    <!-- Modal content -->
    <div
        class="relative p-5 border border-zinc-800 max-w-2xl min-h-96 shadow-lg rounded-md bg-zinc-900"
    >
        <div class="mt-3 text-center">
            <!-- CLOSE FORM -->
            <div class="absolute top-0 right-0 p-2 text-2xl">
                <button
                    id="closeContactModal"
                    class="text-gray-600 hover:text-gray-400">&times;</button
                >
            </div>
            <!-- END OF CLOSE FORM -->
            <h3 class="text-lg leading-6 font-medium text-zinc-300">Contact</h3>
            <div class="mt-2 px-7 py-3">
                <form
                    id="contactForm"
                    method="POST"
                    class="*:bg-zinc-800 *:border-none *:text-white focus:*:outline-none focus:*:outline-gray-300"
                    data-netlify="true"
                >
                    <input
                        type="text"
                        name="name"
                        placeholder="Your Name"
                        class="mb-3 px-3 py-2 rounded w-full bg-zinc-800"
                        required
                    />
                    <input
                        type="email"
                        name="email"
                        placeholder="Your Email"
                        class="mb-3 px-3 py-2 rounded w-full"
                        required
                    />
                    <textarea
                        name="message"
                        rows="4"
                        placeholder="Your Message"
                        class="mb-3 px-3 py-2 rounded w-full"
                        required></textarea>
                    <button
                        type="submit"
                        class="px-4 py-2 bg-zinc-700 text-zinc-300 hover:text-white rounded hover:bg-gray-500 duration-100"
                        >Send</button
                    >
                </form>
            </div>
        </div>
    </div>
</div>
