---
import { Icon } from "astro-icon/components";
---
<div
    id="contactModal"
    class="hidden fixed flex justify-center px-5 items-center z-50 inset-0 bg-light-dark bg-opacity-75 overflow-y-auto h-full w-full transition-opacity duration-300 ease-in-out"
    >
    <!-- Modal content -->
    <div
        class="relative p-6 bg-light-dark rounded-2xl border border-solid border-zinc-700 max-w-lg sm:max-w-xl md:max-w-2xl"
    >
        <div class="mt-3 text-center">
            <!-- CLOSE FORM -->
            <span id="closeContactModal" class="absolute top-3.5 right-3.5 cursor-pointer bg-zinc-800 rounded-xl shadow-md shadow-black/20 p-2 closeModal">
                <Icon name="close" class="h-4 text-gray-400 hover:text-gray-200" />
            </span>
            <!-- END OF CLOSE FORM -->
            <h3 class="text-lg leading-6 font-medium text-zinc-300">Contact</h3>
            <div class="mt-2">
                <form
                    id="contactForm"
                    method="POST"
                    class="*:bg-zinc-800 *:border-none *:text-white focus:*:outline-none focus:*:outline-gray-300"
                    data-netlify="true"
                >
                    <input
                        type="text"
                        name="name"
                        placeholder="Your Name"
                        class="mb-3 px-3 py-2 rounded w-full bg-zinc-800"
                        required
                    />
                    <input
                        type="email"
                        name="email"
                        placeholder="Your Email"
                        class="mb-3 px-3 py-2 rounded w-full"
                        required
                    />
                    <textarea
                        name="message"
                        rows="4"
                        placeholder="Your Message"
                        class="mb-3 px-3 py-2 rounded w-full"
                        required></textarea>
                    <button
                        type="submit"
                        class="px-7 py-3 bg-zinc-800 text-gray-200 hover:text-white rounded-2xl hover:bg-zinc-700 duration-100 ease-in-out"
                        >Send</button
                    >
                </form>
            </div>
        </div>
    </div>
</div>
